# Never commit the real .env file — copy this to ".env" and edit it.
# cp .env.example .env      (Mac/Linux)
# copy .env.example .env    (Windows)

# Used by Flask to sign sessions. Any long random string works for the demo.
SECRET_KEY=change-this-to-a-long-random-string

# Where the database lives. SQLite needs no installation.
# A relative sqlite path is resolved by Flask-SQLAlchemy INSIDE the instance
# folder, so the line below means backend/instance/database.db — which is the
# same file app.py falls back to if this variable is missing. Leave it as it is
# unless you know you want a different file; pointing it somewhere else is the
# quickest way to make the app look like it lost all its data.
# To switch to PostgreSQL later, only this one line changes:
# DATABASE_URL=postgresql://user:password@localhost:5432/shramsetu
DATABASE_URL=sqlite:///database.db

# Which frontend addresses the browser is allowed to call this API from.
# 5173 is Vite's default port. Comma-separated, no spaces.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
